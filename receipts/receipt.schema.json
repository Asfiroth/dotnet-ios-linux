{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dotnet-ios-linux evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "milestone",
    "status",
    "timestampUtc",
    "repositoryRevision",
    "toolchainLockSha256",
    "expectedBehavior",
    "observedBehavior",
    "commands",
    "redaction"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9-]+$" },
    "milestone": { "type": "string", "pattern": "^M(0|[1-9]|10)$" },
    "status": { "enum": ["passed", "failed", "blocked", "superseded"] },
    "timestampUtc": { "type": "string", "format": "date-time" },
    "repositoryRevision": { "type": ["string", "null"] },
    "toolchainLockSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expectedBehavior": { "type": "string", "minLength": 1 },
    "observedBehavior": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "nextDecision": { "type": ["string", "null"] },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exitCode"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" },
          "sanitizedLog": { "type": ["string", "null"] }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "sha256"],
        "properties": {
          "reference": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "excluded"],
      "properties": {
        "performed": { "type": "boolean" },
        "excluded": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
